#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

/ {
    behaviors {
        /* 1. もっさり解消・誤爆防止用の高速Hold-Tap（VialのPermissive Hold相当） */
        mt_fast: mod_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <155>;
            quick-tap-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        lt_fast: layer_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <155>;
            quick-tap-ms = <120>;
            bindings = <&mo>, <&kp>;
        };

        /* 2. Tap Dance 定義（.vil の TD0〜TD7 を再現） */
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp INT5>, <&kp INT4>; /* 1回:無変換 / 2回:変換 */
        };
        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&m1>, <&m2>; /* 1回:Ctrl+Tab / 2回:Ctrl+Shift+Tab */
        };

				td_hold: tap_hold_keys {
						compatible = "zmk,behavior-hold-tap";
						#binding-cells = <2>;
						flavor = "tap-preferred";
						tapping-term-ms = <200>;
						quick-tap-ms = <150>;
						bindings = <&kp>, <&kp>;
				};

        /* 3. ロータリーエンコーダー用ビヘイビア */
        enc_alt_tab: encoder_alt_tab {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp LA(TAB)>, <&kp LS(LA(TAB))>;
        };
        enc_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    /* 4. コンボ定義（10番:P + 11番:BackSpace = Delete） */
    combos {
        compatible = "zmk,combos";
        combo_del {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp DEL>;
        };
    };

    /* 5. マクロ定義（.vil の M0〜M21 を再現） */
    macros {
        m0: m0 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LS(SPACE))>; };
        m1: m1 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(TAB)>; };
        m2: m2 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LS(TAB))>; };
        m3: m3 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(PG_DN)>; };
        m4: m4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(PG_UP)>; };
        m5: m5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(D))>; };
        m6: m6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(T))>; };
        m7: m7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LA(K)>; };
        m8: m8 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(Z)>; };
        m11: m11 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N1)>; };
        m12: m12 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N2)>; };
        m13: m13 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N3)>; };
        m14: m14 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N4)>; };
        m15: m15 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N5)>; };
        m16: m16 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N6)>; };
        m17: m17 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N7)>; };
        m18: m18 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N8)>; };
        m19: m19 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N9)>; };
				m20: m20 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp F17>; };
				m21: m21 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp F18>; };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Base (50-key exact matrix mapping) */
        default_layer {
            display-name = "Base";
            bindings = <
&gresc             &kp Q   &kp W               &kp E            &kp R              &kp T                      &kp Y          &kp U           &kp I      &kp O    &kp P            &kp BSPC
&mt_fast LCTRL TAB &kp A   &kp S               &kp D            &td_hold F13 F     &kp G                      &kp H          &kp J           &kp K      &kp L    &lt_fast 3 SEMI  &lt_fast 4 SQT
&mkp LCLK          &kp Z   &td_hold F16 X      &td_hold F15 C   &td_hold F14 V     &kp B      &m0  &mkp RCLK  &kp N          &kp M           &kp COMMA  &kp DOT  &kp FSLH         &kp RSHFT
&mkp LCLK          &kp F13 &mt_fast LCTRL BSLH                  &kp LGUI &mt_fast LALT INT5 &mt_fast LSHFT SPACE  &lt_fast 1 RET &lt_fast 2 INT4 &td0                &kp MINUS &kp EQUAL       &kp F4
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &enc_alt_tab>;
        };

        /* Layer 1: Symbols / Numbers */
        layer_1 {
            display-name = "SymNum";
            bindings = <
&trans &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT                  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &trans
&trans &kp N1    &kp N2    &kp N3   &kp N4   &kp N5                     &kp N6    &kp N7    &kp N8    &kp N9   &kp N0   &kp PIPE
&trans &kp LBRC  &kp RBRC  &kp LBKT &kp RBKT &kp UNDER &trans &kp PSCRN &kp MINUS &kp EQUAL &kp PLUS  &trans   &trans   &trans
&trans &trans    &trans             &trans   &trans    &trans           &trans    &trans    &trans             &none    &none    &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &enc_scroll>;
        };

        /* Layer 2: Function / BT */
        layer_2 {
            display-name = "Func";
            bindings = <
&trans       &kp F11 &kp F12 &kp F3 &kp F4 &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &trans
&bt BT_SEL 0 &kp F1  &kp F2  &kp F3 &kp F4 &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &trans
&bt BT_SEL 1 &trans  &trans  &trans &trans &trans  &trans  &trans  &trans &trans &trans &trans &trans  &trans
&bt BT_SEL 2 &trans  &trans         &trans &trans  &trans          &trans &trans &trans        &trans &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &enc_scroll>;
        };

        /* Layer 3: Navigation / Edit */
        layer_3 {
            display-name = "Nav";
            bindings = <
&trans &none     &m4       &td2      &m3       &mkp LCLK                  &kp PG_UP &kp HOME &kp UP   &kp END   &none &none
&trans &none     &kp F2    &none     &kp F4    &kp F13                    &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &none &none
&trans &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(B)  &trans  &trans  &m8       &m4      &td2     &m3       &none &none
&trans &none     &none               &trans    &trans     &trans          &kp BSPC  &kp DEL  &m7                &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &enc_scroll>;
        };

        /* Layer 4: Macros */
        layer_4 {
            display-name = "Macro";
            bindings = <
&none &none &none &none &none &none                  &none &none &none &none &none &none
&m20  &m11  &m12  &m13  &m14  &m15                   &m16  &m17  &m18  &m19  &none &none
&m21  &none &none &none &none &none  &trans  &trans  &none &none &none &none &none &none
&none &none &none       &none &trans &trans          &m5   &m6   &none       &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &enc_scroll>;
        };

        /* Layer 5: Mouse */
        layer_5 {
            display-name = "Mouse";
            bindings = <
&none &none &none &none     &none     &none                     &msc SCRL_UP   &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT &none &none
&none &none &none &none     &none     &none                     &mkp MCLK      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
&none &none &none &none     &none     &none &kp C_MUTE &mkp MCLK &msc SCRL_DOWN &none          &none          &none           &none &none
&none &none &none           &mkp LCLK &mkp RCLK &mkp MCLK       &none          &none          &none                          &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &enc_scroll>;
        };

        /* Layer 6: System */
        layer_6 {
            display-name = "Sys";
            bindings = <
&none        &none &none &none &none &none                     &none &none &none &none &none &none
&bt BT_SEL 0 &none &none &none &none &none                     &none &none &none &none &none &none
&bt BT_SEL 1 &none &none &none &none &none &kp C_MUTE &mkp MCLK &none &none &none &none &none &none
&bt BT_SEL 2 &none &none       &none &none &none               &none &none &none             &none &none &none
>;
sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &enc_scroll>;
};
/* Layer 7: Extra Edit */
layer_7 {
display-name = "Edit2";
bindings = <
&trans &mt_fast RCTRL Q &mt_fast RCTRL W &kp END &none     &none                  &none    &none &none &none &kp UP   &none
&trans &kp HOME         &none            &kp DEL &kp RIGHT &none                  &kp BSPC &none &m7   &none &none    &none
&trans &mt_fast RCTRL Z &mt_fast RCTRL X &mt_fast RCTRL C &mt_fast RCTRL V &kp LEFT &none &none &kp DOWN &none &none &none &none &none
&none  &none            &none                     &none   &none     &none          &none    &none &none       &none &none &none
>;
sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &enc_scroll>;
};
};
};